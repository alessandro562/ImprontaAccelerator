---
/** Immagine con didascalia. Senza file, segnaposto dichiarato. */
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  placeholder?: string;
  ratio?: string;
  class?: string;
}
const { src, alt, caption, placeholder, ratio = '4/3', class: className = '' } = Astro.props;
---
<figure class:list={[className]}>
  {src ? (
    <img src={src} alt={alt ?? ''} class="w-full rounded-[6px] border border-line object-cover" style={`aspect-ratio:${ratio}`} />
  ) : (
    <div
      class="flex items-center justify-center rounded-[6px] border border-dashed border-line bg-paper-alt p-6"
      style={`aspect-ratio:${ratio}`}
      data-asset={placeholder}
    >
      <p class="t-small text-center text-ink-muted">FOTO DA INSERIRE — {placeholder}</p>
    </div>
  )}
  {caption && <figcaption class="t-small mt-3 text-ink-muted">{caption}</figcaption>}
</figure>
