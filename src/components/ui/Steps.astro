---
/** Sequenza numerata con durata. Lista ordinata, numeri tabular in forest. */
interface Props {
  steps: { name: string; detail?: string; when?: string }[];
  class?: string;
}
const { steps, class: className = '' } = Astro.props;

// Le colonne seguono il numero di passi: con il fondo a griglia le celle vuote
// lascerebbero rettangoli grigi.
const COLS: Record<number, string> = {
  1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4', 5: 'md:grid-cols-3 lg:grid-cols-5',
  6: 'md:grid-cols-3 lg:grid-cols-6',
};
const cols = COLS[steps.length] ?? 'md:grid-cols-3';
---
<ol class:list={['grid gap-x-8 gap-y-8 border-t border-line', cols, className]}>
  {steps.map((step, i) => (
    <li class="border-t border-line pt-4 first:border-t-0 md:border-t-0 md:pt-6">
      <span class="t-figure block text-forest" aria-hidden="true">{i + 1}</span>
      <h3 class="t-h3 mt-3 text-ink">{step.name}</h3>
      {step.when && <p class="t-label mt-2">{step.when}</p>}
      {step.detail && <p class="t-small mt-2 text-ink-muted">{step.detail}</p>}
    </li>
  ))}
</ol>
