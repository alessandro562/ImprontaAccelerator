---
/** H2 piu' un lead opzionale. Allineato a sinistra, senza eyebrow. */
interface Props { title: string; lead?: string; class?: string }
const { title, lead, class: className = '' } = Astro.props;
---
<header class:list={['max-w-3xl', className]}>
  <h2 class="t-h2">{title}</h2>
  {lead && <p class="t-lead mt-5 text-ink-muted">{lead}</p>}
</header>
