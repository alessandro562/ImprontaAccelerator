---
/** Fascia dati chiave: etichetta sopra, valore sotto. */
interface Props {
  items: { label: string; value: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<dl
  class:list={[
    'grid grid-cols-1 gap-px overflow-hidden rounded-[6px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-5',
    className,
  ]}
>
  {items.map((item) => (
    <div class="bg-forest-tint px-5 py-4">
      <dt class="t-label">{item.label}</dt>
      <dd class="t-figure mt-2 text-ink">{item.value}</dd>
    </div>
  ))}
</dl>
