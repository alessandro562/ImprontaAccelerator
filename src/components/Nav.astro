---
import Cta from './Cta.astro';
import Logo from './Logo.astro';
import { useTranslations } from '../i18n';
import { localeUrl, pageKeyFromUrl, LOCALES, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /**
   * Barra scura fin da subito. Nel concept la nav sta sopra l'hero scuro e i
   * suoi colori sono pensati per quello: su una pagina di solo testo il logo e
   * le voci di menu sarebbero bianchi su fondo chiaro, cioe' invisibili.
   */
  solida?: boolean;
}
const { locale, solida = false } = Astro.props;
const t = useTranslations(locale);
const home = localeUrl(locale);

// Fuori dalla home le ancore devono tornare alla home, non cercare una sezione
// che in quella pagina non esiste.
const pageKey = pageKeyFromUrl(Astro.url.pathname);
const anchor = (id: string) => (pageKey === '' ? `#${id}` : `${home}#${id}`);
const other = LOCALES.find((code) => code !== locale)!;
---
<header class:list={['nav', solida && 'is-solid']} id="nav">
  <div class="nav__bar">
    <a href={pageKey === '' ? '#top' : home} aria-label={t.meta.homeLabel}>
      <Logo class="nav__logo" label={t.meta.logoLabel} />
    </a>
    <ul class="nav__links">
      {t.nav.items.map((item) => (
        <li><a href={anchor(item.id)}>{item.label}</a></li>
      ))}
    </ul>
    <div class="nav__right">
      <a
        class="nav__lang"
        href={localeUrl(other, pageKey)}
        data-href={localeUrl(other, pageKey)}
        data-lang-switch
        hreflang={other}
        aria-label={t.nav.langLabel}
      ><b>{locale.toUpperCase()}</b> / {other.toUpperCase()}</a>
      <Cta locale={locale} source="nav" label={t.nav.cta} />
    </div>
  </div>
</header>

<script>
  // Il fragment (#programma) non viene mai inviato al server: un href statico lo
  // perderebbe. Riscriviamo l'href — invece di intercettare il click — così
  // continuano a funzionare ctrl+click, click centrale e "copia indirizzo".
  const sync = () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
      a.href = (a.dataset.href ?? '') + location.hash;
    });
  };
  sync();
  addEventListener('hashchange', sync);
</script>
