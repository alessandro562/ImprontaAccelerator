---
import Logo from './Logo.astro';
import Cta from './Cta.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n';
import { localeUrl, pageKeyFromUrl, type Locale } from '../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localeUrl(locale);
const conditions = localeUrl(locale, 'condizioni');
const sectionsLabel = locale === 'it' ? 'Sezioni' : 'Sections';

// Fuori dalla home le ancore devono tornare alla home, non cercare una
// sezione che in quella pagina non esiste.
const anchor = (id: string) => (pageKeyFromUrl(Astro.url.pathname) === '' ? `#${id}` : `${home}#${id}`);
---
<header data-site-header class="sticky top-0 z-50 border-b border-line bg-paper">
  <div class="container-page flex h-16 items-center justify-between gap-6 md:h-[72px]">
    <a href={home} class="shrink-0" aria-label="Impronta Accelerator">
      <Logo class="h-8 w-auto md:h-9" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label={sectionsLabel}>
      {t.nav.items.map((item) => (
        <a href={anchor(item.id)} class="font-sans text-[15px] text-ink-muted transition-colors hover:text-ink">
          {item.label}
        </a>
      ))}
      <a href={conditions} class="font-sans text-[15px] text-ink-muted transition-colors hover:text-ink">
        {t.nav.conditions}
      </a>
    </nav>

    <div class="flex items-center gap-4">
      <LanguageSwitcher locale={locale} label={t.nav.langLabel} />
      <!-- il contenitore nasconde la CTA: `hidden` sul pulsante perderebbe
           contro l'`inline-flex` della sua classe di base -->
      <span class="hidden sm:block">
        <Cta locale={locale} source="nav" label={t.nav.cta} />
      </span>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded-[6px] border border-ink-muted text-ink lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label={t.nav.openMenu}
        data-open-label={t.nav.openMenu}
        data-close-label={t.nav.closeMenu}
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" hidden class="border-t border-line bg-paper lg:hidden">
    <nav class="container-page flex flex-col py-2" aria-label={sectionsLabel}>
      {t.nav.items.map((item) => (
        <a href={anchor(item.id)} class="border-b border-line py-3 font-sans text-base text-ink">{item.label}</a>
      ))}
      <a href={conditions} class="border-b border-line py-3 font-sans text-base text-ink">{t.nav.conditions}</a>
      <Cta locale={locale} source="nav-mobile" label={t.nav.cta} class="mt-4 mb-4 w-full" />
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      const label = open ? toggle.dataset.closeLabel : toggle.dataset.openLabel;
      if (label) toggle.setAttribute('aria-label', label);
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    // chiudere dopo il salto all'ancora, altrimenti il menu copre la sezione
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
