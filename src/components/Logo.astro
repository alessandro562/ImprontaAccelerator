---
import Positivo from '../assets/logo-impronta.svg';
import Negativo from '../assets/logo-impronta-negativo.svg';
import Mono from '../assets/logo-impronta-mono.svg';

const VARIANTS = { positivo: Positivo, negativo: Negativo, mono: Mono };

interface Props {
  variant?: keyof typeof VARIANTS;
  class?: string;
  label?: string;
}

const { variant = 'positivo', class: className = 'h-9 w-auto', label = 'Impronta — acceleratore di impatto' } = Astro.props;
const Mark = VARIANTS[variant];
---
<Mark class={className} role="img" aria-label={label} />
