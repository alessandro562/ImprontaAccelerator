---
/** Un'istanza del marchio. Il contenuto sta in LogoSprite, incluso nel layout. */
interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label = 'Impronta' } = Astro.props;
---
<svg class={className} viewBox="0 0 1083.22 240" role="img" aria-label={label}><use href="#logo"/></svg>
