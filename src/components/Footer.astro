---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n';
import { localeUrl, pageKeyFromUrl, type Locale } from '../i18n/utils';
import { CONTACT_EMAIL, PARTNER_URLS, SOCIAL, VENUE } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localeUrl(locale);

// Fuori dalla home le ancore devono tornare alla home.
const anchor = (id: string) => (pageKeyFromUrl(Astro.url.pathname) === '' ? `#${id}` : `${home}#${id}`);

const orgs = [
  { name: 'Next4', url: PARTNER_URLS.next4 },
  { name: 'ELIS Innovation Hub', url: PARTNER_URLS.elis },
  { name: 'WDA', url: PARTNER_URLS.wda },
];

const socials = Object.entries(SOCIAL).filter(([, url]) => url.length > 0);
const year = new Date().getFullYear();
---
<footer class="on-dark bg-forest-deep text-white">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <Logo variant="negativo" class="h-9 w-auto" />
        <p class="t-small mt-5 max-w-xs text-forest-soft">{t.footer.tagline}</p>

        <p class="t-label mt-8 text-forest-soft">{t.footer.promotersTitle}</p>
        <ul class="mt-3 space-y-1">
          {orgs.map((org) => (
            <li>
              <a href={org.url} target="_blank" rel="noopener" class="t-link t-small">{org.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <nav class="lg:col-span-3" aria-label={t.footer.navTitle}>
        <p class="t-label text-forest-soft">{t.footer.navTitle}</p>
        <ul class="mt-3 space-y-1">
          {t.nav.items.map((item) => (
            <li><a href={anchor(item.id)} class="t-small text-white transition-colors hover:text-forest-soft">{item.label}</a></li>
          ))}
          <li><a href={localeUrl(locale, 'condizioni')} class="t-small text-white transition-colors hover:text-forest-soft">{t.footer.conditions}</a></li>
        </ul>

        <p class="t-label mt-8 text-forest-soft">{t.footer.contactTitle}</p>
        <address class="t-small mt-3 space-y-1 not-italic text-white">
          <a href={`mailto:${CONTACT_EMAIL}`} class="t-link block">{CONTACT_EMAIL}</a>
          <span class="block text-forest-soft">{VENUE.name}, {VENUE.street}</span>
          <span class="block text-forest-soft">{VENUE.postalCode} {VENUE.city}</span>
        </address>

        {socials.length > 0 && (
          <ul class="mt-4 flex gap-5">
            {socials.map(([name, url]) => (
              <li><a href={url} target="_blank" rel="noopener" class="t-link t-small capitalize">{name}</a></li>
            ))}
          </ul>
        )}
      </nav>

      <div class="lg:col-span-5">
        <p class="t-label text-forest-soft">{t.footer.institutionalLabel}</p>
        <div
          class="mt-3 flex min-h-20 items-center rounded-[6px] border border-dashed border-forest-soft/60 px-4 py-3"
          data-asset={t.footer.institutionalPlaceholder}
        >
          <p class="t-small text-forest-soft">{t.footer.institutionalPlaceholder}</p>
        </div>
        <p class="t-small mt-4 text-forest-soft">{t.footer.funding}</p>

        <p class="t-label mt-8 text-forest-soft">{t.footer.legalTitle}</p>
        <ul class="mt-3 space-y-1">
          <li><a href={localeUrl(locale, 'privacy')} class="t-small text-white transition-colors hover:text-forest-soft">{t.footer.privacy}</a></li>
          <li><a href={localeUrl(locale, 'cookie')} class="t-small text-white transition-colors hover:text-forest-soft">{t.footer.cookie}</a></li>
        </ul>
      </div>
    </div>

    <div class="t-small mt-14 flex flex-col gap-2 border-t border-forest-soft/30 pt-6 text-forest-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Impronta Accelerator. {t.footer.rights}</p>
      <p>
        <a href={PARTNER_URLS.lazioInnova} target="_blank" rel="noopener" class="t-link">
          Lazio Innova — Regione Lazio
        </a>
      </p>
    </div>
  </div>
</footer>
