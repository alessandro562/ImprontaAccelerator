---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n';
import { localeUrl, type Locale } from '../i18n/utils';
import { CONTACT_EMAIL, PARTNER_URLS, SOCIAL, VENUE } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const orgs = [
  { name: 'Next4', url: PARTNER_URLS.next4 },
  { name: 'ELIS Innovation Hub', url: PARTNER_URLS.elis },
  { name: 'WDA', url: PARTNER_URLS.wda },
];

const socials = Object.entries(SOCIAL).filter(([, url]) => url.length > 0);
const year = new Date().getFullYear();
---
<footer class="bg-forest-deep text-white">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Logo variant="negativo" class="h-10 w-auto" />
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-forest-soft">{t.footer.tagline}</p>

        <p class="mt-8 text-xs font-semibold uppercase tracking-widest text-forest-soft">{t.footer.promotersTitle}</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          {orgs.map((org) => (
            <li>
              <a href={org.url} target="_blank" rel="noopener" class="text-sm font-medium text-white underline-offset-4 hover:underline">
                {org.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-forest-soft">{t.footer.navTitle}</p>
        <ul class="mt-3 space-y-2">
          {t.nav.items.map((item) => (
            <li>
              <a href={`#${item.id}`} class="text-sm text-forest-soft transition-colors hover:text-white">{item.label}</a>
            </li>
          ))}
        </ul>

        <p class="mt-8 text-xs font-semibold uppercase tracking-widest text-forest-soft">{t.footer.contactTitle}</p>
        <address class="mt-3 space-y-1 text-sm not-italic text-forest-soft">
          <a href={`mailto:${CONTACT_EMAIL}`} class="block transition-colors hover:text-white">{CONTACT_EMAIL}</a>
          <span class="block">{VENUE.name}, {VENUE.street}</span>
          <span class="block">{VENUE.postalCode} {VENUE.city}</span>
        </address>

        {socials.length > 0 && (
          <ul class="mt-4 flex gap-4">
            {socials.map(([name, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener" class="text-sm capitalize text-forest-soft transition-colors hover:text-white">{name}</a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-forest-soft">{t.footer.institutionalLabel}</p>
        <p class="mt-3 text-sm leading-relaxed text-forest-soft">{t.footer.funding}</p>

        <p class="mt-8 text-xs font-semibold uppercase tracking-widest text-forest-soft">{t.footer.legalTitle}</p>
        <ul class="mt-3 space-y-2">
          <li><a href={localeUrl(locale, 'privacy')} class="text-sm text-forest-soft transition-colors hover:text-white">{t.footer.privacy}</a></li>
          <li><a href={localeUrl(locale, 'cookie')} class="text-sm text-forest-soft transition-colors hover:text-white">{t.footer.cookie}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-forest-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Impronta Accelerator. {t.footer.rights}</p>
      <p>
        <a href={PARTNER_URLS.lazioInnova} target="_blank" rel="noopener" class="transition-colors hover:text-white">
          Lazio Innova — Regione Lazio
        </a>
      </p>
    </div>
  </div>
</footer>
