---
import Logo from './Logo.astro';
import { useTranslations } from '../i18n';
import { localeUrl, type Locale } from '../i18n/utils';
import { CONTACT_EMAIL, F6S_APPLICATION_URL, hasF6sApplication } from '../config';
/*
 * I quattro marchi stanno in quattro file e non in una striscia sola: in
 * un'immagine unica da 15,7:1, su un telefono, l'emblema europeo sarebbe alto
 * venti pixel. Separati vanno a capo e restano leggibili. L'ordine e'
 * alfabetico, cioe' quello del documento originale.
 */
const loghiFesr = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>('../assets/fesr/*.webp', { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, modulo]) => modulo.default);

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <div><Logo class="foot__logo" label="Impronta" /></div>
      <div><p>{t.footer.promoters}</p><p>{t.footer.address}</p></div>
      {/*
        F6S. Non e' un canale da cui arriva qualcuno: e' un adempimento, il
        link che F6S chiede di avere sul sito. Sta qui e non vicino alla CTA
        perche' li' occuperebbe il punto che converte per parlare a nessuno.
        L'etichetta non dice «candidati»: la candidatura e' una sola, ed e'
        quella sulla piattaforma del programma.
      */}
      {hasF6sApplication && (
        <div>
          <a class="foot__f6s" href={F6S_APPLICATION_URL} target="_blank" rel="noopener">
            {t.footer.f6s}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"/></svg>
          </a>
        </div>
      )}
    </div>
    {/*
      Visibilita' FESR. I marchi sono le versioni negative, generate da
      `npm run fesr`: sul fondo scuro i marchi colorati si leggono, a sparire
      e' solo il lettering blu, che li' e' bianco. Il testo non e' piu' cotto
      dentro il PNG: e' composto con i caratteri della landing, sotto i marchi.
    */}
    <div class="foot__fesr">
      <div class="foot__fesr-loghi" role="img" aria-label={t.footer.fesrLoghi}>
        {loghiFesr.map((logo) => (
          <img src={logo.src} alt="" width={logo.width} height={logo.height} loading="lazy" decoding="async" />
        ))}
      </div>
      <p class="foot__fesr-testo">{t.footer.fesr}</p>
    </div>

    <div class="foot__legal">
      <span>{t.footer.rights}</span>
      <nav aria-label={t.footer.legalLabel}>
        <a href={localeUrl(locale, 'privacy')}>{t.footer.privacy}</a>
        <a href={localeUrl(locale, 'cookie')}>{t.footer.cookie}</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{t.footer.contact}</a>
      </nav>
    </div>
  </div>
</footer>
