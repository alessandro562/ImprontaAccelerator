---
import Button from './ui/Button.astro';
import { APPLICATION_FORM_URL, CONTACT_EMAIL, hasApplicationForm } from '../config';
import { useTranslations } from '../i18n';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** da dove parte il click: finisce in utm_content per l'attribuzione */
  source: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'link' | 'on-dark';
  class?: string;
}

const { locale, source, label, variant = 'primary', class: className = '' } = Astro.props;
const t = useTranslations(locale);
const text = label ?? t.hero.ctaPrimary;

/**
 * Finché APPLICATION_FORM_URL non è impostato la CTA non viene disattivata:
 * ricade sull'email di contatto, così la pagina resta pubblicabile e
 * funzionante. Sostituire l'URL in src/config.ts è una modifica di una riga.
 */
let url: string;
if (hasApplicationForm) {
  const u = new URL(APPLICATION_FORM_URL);
  u.searchParams.set('lang', locale);
  u.searchParams.set('utm_source', 'landing');
  u.searchParams.set('utm_medium', 'cta');
  u.searchParams.set('utm_content', source);
  url = u.toString();
} else {
  const subject = locale === 'it' ? 'Candidatura a Impronta Accelerator' : 'Application to Impronta Accelerator';
  url = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;
}

// Su fondo scuro il magenta perde contrasto: si passa al bianco pieno.
const onDark = variant === 'on-dark';
const buttonVariant = onDark ? 'primary' : variant;
const classes = [onDark ? 'bg-white text-ink hover:bg-paper-alt' : '', className].filter(Boolean).join(' ');
---
<Button variant={buttonVariant} href={url} external={hasApplicationForm} class={classes}>
  {text}
</Button>
