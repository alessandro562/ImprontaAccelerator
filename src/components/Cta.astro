---
import { APPLICATION_FORM_URL, CONTACT_EMAIL, hasApplicationForm } from '../config';
import type { Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  /** da dove parte il click: finisce in utm_content per l'attribuzione */
  source: string;
  label: string;
  class?: string;
}

const { locale, source, label, class: className = 'btn btn--light' } = Astro.props;

/**
 * Finché APPLICATION_FORM_URL non è impostato la CTA ricade sull'email di
 * contatto, così la pagina resta pubblicabile e funzionante.
 */
let url: string;
if (hasApplicationForm) {
  const u = new URL(APPLICATION_FORM_URL);
  u.searchParams.set('lang', locale);
  u.searchParams.set('utm_source', 'landing');
  u.searchParams.set('utm_medium', 'cta');
  u.searchParams.set('utm_content', source);
  url = u.toString();
} else {
  const subject = locale === 'it' ? 'Candidatura a Impronta Accelerator' : 'Application to Impronta Accelerator';
  url = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;
}
---
<a
  class={className}
  href={url}
  target={hasApplicationForm ? '_blank' : undefined}
  rel={hasApplicationForm ? 'noopener' : undefined}
>
  {label}
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"/></svg>
</a>
