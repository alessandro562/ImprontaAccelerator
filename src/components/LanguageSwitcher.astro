---
import { LOCALES, localeUrl, pageKeyFromUrl, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  label: string;
  class?: string;
}
const { locale, label, class: className = '' } = Astro.props;
const pageKey = pageKeyFromUrl(Astro.url.pathname);
const NAMES: Record<Locale, string> = { it: 'Italiano', en: 'English' };
---
<nav class:list={['flex items-center', className]} aria-label={label}>
  {LOCALES.map((code, index) => {
    const url = localeUrl(code, pageKey);
    const active = code === locale;
    return (
      <>
        {index > 0 && <span class="px-1.5 text-line" aria-hidden="true">/</span>}
        <a
          href={url}
          data-href={url}
          data-lang-switch
          hreflang={code}
          lang={code}
          aria-current={active ? 'true' : undefined}
          title={NAMES[code]}
          class:list={[
            'font-sans text-[13px] uppercase tracking-[0.04em] transition-colors',
            active ? 'font-semibold text-ink' : 'text-ink-muted hover:text-ink',
          ]}
        >
          {code}
        </a>
      </>
    );
  })}
</nav>

<script>
  // Il fragment (#faq) non viene mai inviato al server: un href statico lo
  // perderebbe. Riscriviamo l'href — invece di intercettare il click — così
  // continuano a funzionare ctrl+click, click centrale e "copia indirizzo".
  const sync = () => {
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
      a.href = (a.dataset.href ?? '') + location.hash;
    });
  };
  sync();
  addEventListener('hashchange', sync);
</script>
