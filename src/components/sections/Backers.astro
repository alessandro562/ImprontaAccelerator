---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="partner" class="bg-bone">
  <div class="shell py-20 md:py-28">
    <p class="eyebrow">{t.backers.eyebrow}</p>
    <h2 class="display-lg mt-5 max-w-[18ch] text-ink">{t.backers.title}</h2>
    <p class="measure-wide mt-6 text-lg text-slate">{t.backers.lead}</p>

    <!-- Nomi, non un conteggio anonimo: «oltre 100 corporate» non dice niente. -->
    <div class="mt-14 border-t-2 border-ink pt-8">
      <p class="font-display text-sm font-bold uppercase tracking-widest text-slate">
        {t.backers.corporatesLabel}
      </p>
      <ul class="mt-5 flex flex-wrap items-baseline gap-x-8 gap-y-3">
        {t.backers.corporates.map((name) => (
          <li class="font-display text-xl font-bold tracking-tight text-ink md:text-2xl">{name}</li>
        ))}
      </ul>
      <p class="mt-5 text-xs text-slate">{t.backers.corporatesNote}</p>
    </div>

    <dl class="mt-16 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {t.backers.stats.map((stat) => (
        <div>
          <dt class="stat text-[clamp(2rem,4.4vw,3.25rem)] text-ink">{stat.value}</dt>
          <dd class="measure mt-2 text-sm leading-snug text-slate">{stat.label}</dd>
        </div>
      ))}
    </dl>

    <ul class="mt-16 grid gap-10 md:grid-cols-3 md:gap-12">
      {t.backers.orgs.map((org) => (
        <li class="border-t border-line pt-6">
          <h3 class="font-display text-2xl font-extrabold tracking-tight text-ink">{org.name}</h3>
          <p class="mt-1.5 text-sm font-semibold text-brand-magenta">{org.role}</p>
          <p class="mt-4 text-sm leading-relaxed text-slate">{org.text}</p>
          <a
            href={org.url}
            target="_blank"
            rel="noopener"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ink underline-offset-4 hover:underline"
          >
            {org.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 3h7v7M13 3L4 12" />
            </svg>
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-14">
      <details class="disclosure">
        <summary class="text-ink">{t.backers.detailsLabel}</summary>
        <div class="pb-2 pt-4">
          <p class="text-sm text-slate">{t.backers.ecosystemIntro}</p>
          <p class="mt-3 text-sm font-medium text-ink">{t.backers.ecosystem.join(' · ')}</p>
        </div>
      </details>
    </div>
  </div>
</section>
