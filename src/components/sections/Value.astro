---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const TAG_STYLES: Record<number, string> = {
  0: 'bg-mint-50 text-forest',
  1: 'bg-amber-50 text-coral-deep',
  2: 'bg-brand-magenta/10 text-magenta-deep',
};
// il tag è testuale e tradotto: l'indice di stile segue l'ordine di comparsa
const tagIndex = new Map<string, number>();
---
<section class="bg-cream">
  <div class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.value.eyebrow}</p>
      <h2 class="mt-5 text-3xl leading-tight text-ink md:text-4xl lg:text-5xl">{t.value.title}</h2>
      <p class="mt-6 text-lg leading-relaxed text-slate">{t.value.intro}</p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.value.items.map((item) => {
        if (!tagIndex.has(item.tag)) tagIndex.set(item.tag, tagIndex.size);
        const style = TAG_STYLES[tagIndex.get(item.tag)! % 3];
        return (
          <li class="card flex flex-col p-7">
            <span class={`inline-flex w-fit rounded-full px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wider ${style}`}>
              {item.tag}
            </span>
            <h3 class="mt-5 text-xl leading-snug text-ink">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate">{item.text}</p>
          </li>
        );
      })}
    </ul>
  </div>
</section>
