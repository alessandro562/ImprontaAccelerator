---
import Cta from '../Cta.astro';
import Pittogramma from '../Pittogramma.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { CONTACT_EMAIL, F6S_APPLICATION_URL, formattedDeadline, hasApplicationForm, hasF6sApplication } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/*
 * La frase di chiusura ha tre stati. Con la data si annuncia la scadenza.
 * Senza data ma con la piattaforma gia' attiva si usa il presente, perche' le
 * candidature si raccolgono davvero adesso. Prima che la piattaforma esista,
 * il futuro.
 */
const deadline = formattedDeadline(locale);
const raccolta = deadline ? null : hasApplicationForm ? t.chiusura.open : t.chiusura.pending;
---
<section class="close" aria-labelledby="close-title">
  <div class="wrap" style="position:relative;z-index:2">
    <Pittogramma id="cg" class="close__art" />
    <span class="label" data-in><span>{t.chiusura.label}</span></span>
    <h2 class="display" id="close-title" data-in="2">
      {t.chiusura.title.before}<span class="it">{t.chiusura.title.accent}</span>
    </h2>
    <p data-in="3">
      {deadline
        ? <>{t.chiusura.deadlinePrefix} <strong style="color:var(--paper);font-weight:500">{deadline}</strong>{t.chiusura.deadlineSuffix}</>
        : raccolta}
    </p>
    <div data-in="3">
      <Cta locale={locale} source="chiusura" label={t.chiusura.cta} />
    </div>

    {/*
      F6S non e' il canale principale: la candidatura ufficiale e' quella del
      pulsante qui sopra. La riga sta sotto, piu' piccola, e si apre con una
      domanda invece che con un invito — chi non arriva da F6S non ha niente
      da decidere. Vedi F6S_APPLICATION_URL in config.ts.
    */}
    {hasF6sApplication && (
      <p class="close__f6s" data-in="3">
        <span>{t.chiusura.f6sPrefix}</span>
        <a class="link" href={F6S_APPLICATION_URL} target="_blank" rel="noopener">
          {t.chiusura.f6sCta}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"/></svg>
        </a>
      </p>
    )}
    <span class="close__mail" data-in="4">
      {t.chiusura.mailPrefix} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </span>
  </div>
</section>
