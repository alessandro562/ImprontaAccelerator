---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="faq" class="bg-cream">
  <div class="shell py-20 md:py-28">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 class="display-lg mt-5 text-ink">{t.faq.title}</h2>
      </div>

      <div>
        {t.faq.items.map((item, i) => (
          <details class="disclosure group" open={i === 0}>
            <summary class="text-base text-ink md:text-lg">{item.q}</summary>
            <p class="measure-wide pb-6 text-sm leading-relaxed text-slate md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
