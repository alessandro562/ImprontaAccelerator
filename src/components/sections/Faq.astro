---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import FaqItem from '../ui/FaqItem.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { CONTACT_EMAIL } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Section id="faq">
  <SectionHeader title={t.faq.title} />

  <div class="mt-10 max-w-3xl">
    {t.faq.groups.map((group) => (
      <div class="mb-10 last:mb-0">
        <h3 class="t-label border-b border-ink pb-2">{group.name}</h3>
        {group.items.map((item) => (
          <FaqItem question={item.q}>{item.a}</FaqItem>
        ))}
      </div>
    ))}

    <p class="t-body mt-10 text-ink-muted">
      {t.faq.contactPrefix}{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="t-link">{CONTACT_EMAIL}</a>
    </p>
  </div>
</Section>
