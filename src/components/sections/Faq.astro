---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="faq" class="border-t border-line bg-white">
  <div class="shell py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.7fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{t.faq.eyebrow}</p>
        <h2 class="mt-5 text-3xl leading-tight text-ink md:text-4xl">{t.faq.title}</h2>
      </div>

      <!-- <details> nativo: accessibile da tastiera senza una riga di JS -->
      <div class="divide-y divide-line border-y border-line">
        {t.faq.items.map((item) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-base font-semibold text-ink marker:hidden md:text-lg">
              {item.q}
              <span
                class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-line text-slate transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <svg viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M8 3v10M3 8h10" />
                </svg>
              </span>
            </summary>
            <p class="pb-6 pr-10 text-sm leading-relaxed text-slate md:text-base">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Safari mostra comunque il triangolo senza questa regola */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
