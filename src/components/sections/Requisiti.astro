---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import DataTable from '../ui/DataTable.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Section id="requisiti" background="paper-alt">
  <SectionHeader title={t.requisiti.title} lead={t.requisiti.lead} />

  <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h3 class="t-h3 text-ink">{t.requisiti.yesTitle}</h3>
      <ul class="mt-5 border-t border-line">
        {t.requisiti.yes.map((item) => (
          <li class="t-body border-b border-line py-4 text-ink">{item}</li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="t-h3 text-ink">{t.requisiti.noTitle}</h3>
      <ul class="mt-5 border-t border-line">
        {t.requisiti.no.map((item) => (
          <li class="t-body border-b border-line py-4 text-ink-muted">{item}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="mt-16">
    <h3 class="t-h3 text-ink">{t.requisiti.criteriaTitle}</h3>
    <DataTable
      class="mt-5"
      headers={t.requisiti.criteriaHeaders}
      rows={t.requisiti.criteria}
    />
  </div>
</Section>
