---
import Cta from '../Cta.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const AREA_ACCENT = ['bg-brand-green', 'bg-brand-amber', 'bg-brand-magenta'];
---
<section id="target" class="border-t border-line bg-white">
  <div class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.target.eyebrow}</p>
      <h2 class="mt-5 text-3xl leading-tight text-ink md:text-4xl lg:text-5xl">{t.target.title}</h2>
      <p class="mt-6 text-lg leading-relaxed text-slate">{t.target.intro}</p>
    </div>

    <!-- Qualificazione: chi è in target e chi non lo è -->
    <div class="mt-14 grid gap-6 lg:grid-cols-[1.35fr_1fr]">
      <div class="rounded-2xl border border-forest/20 bg-mint-50 p-7 md:p-9">
        <h3 class="text-xl text-ink">{t.target.checklistTitle}</h3>
        <ul class="mt-6 space-y-4">
          {t.target.checklist.map((line) => (
            <li class="flex gap-3.5">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-forest" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 10.5l4 4 8-9" />
              </svg>
              <span class="text-sm leading-relaxed text-ink">{line}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-line bg-cream p-7 md:p-9">
        <h3 class="text-xl text-ink">{t.target.notForYouTitle}</h3>
        <ul class="mt-6 space-y-4">
          {t.target.notForYou.map((line) => (
            <li class="flex gap-3.5">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-slate-soft" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l8 8M14 6l-8 8" />
              </svg>
              <span class="text-sm leading-relaxed text-slate">{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Macro-aree di impatto -->
    <div class="mt-20">
      <h3 class="text-2xl text-ink md:text-3xl">{t.target.areasTitle}</h3>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate">{t.target.areasIntro}</p>

      <ul class="mt-9 grid gap-5 md:grid-cols-3">
        {t.target.areas.map((area, i) => (
          <li class="card overflow-hidden">
            <div class={`h-1.5 ${AREA_ACCENT[i % 3]}`} aria-hidden="true"></div>
            <div class="p-7">
              <h4 class="text-xl text-ink">{area.name}</h4>
              <p class="mt-3 text-sm leading-relaxed text-slate">{area.text}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {area.verticals.map((vertical) => (
                  <li class="rounded-full border border-line bg-cream px-3 py-1 text-xs font-medium text-ink">{vertical}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-7 rounded-2xl border border-dashed border-line bg-cream p-6">
        <p class="text-sm font-semibold text-ink">{t.target.emergingLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {t.target.emerging.map((item) => (
            <li class="rounded-full bg-white px-3 py-1 text-xs font-medium text-slate">{item}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Criteri di valutazione -->
    <div class="mt-20">
      <h3 class="text-2xl text-ink md:text-3xl">{t.target.criteriaTitle}</h3>
      <dl class="mt-9 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {t.target.criteria.map((criterion, i) => (
          <div class="border-t-2 border-line pt-5">
            <dt class="flex items-baseline gap-2.5 text-base font-semibold text-ink">
              <span class="font-display text-sm text-brand-magenta">0{i + 1}</span>
              {criterion.title}
            </dt>
            <dd class="mt-2.5 text-sm leading-relaxed text-slate">{criterion.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-14 flex justify-center">
      <Cta locale={locale} source="target" class="text-base" />
    </div>
  </div>
</section>
