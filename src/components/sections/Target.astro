---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const AREA_ACCENT = ['text-brand-green', 'text-brand-amber', 'text-brand-magenta'];
---
<section id="target" class="bg-cream">
  <div class="shell py-20 md:py-28">
    <p class="eyebrow" data-reveal>{t.target.eyebrow}</p>
    <h2 class="display-lg mt-5 max-w-[20ch] text-ink" data-reveal>{t.target.title}</h2>
    <p class="measure-wide mt-6 text-lg text-slate" data-reveal>{t.target.lead}</p>

    <!-- Due colonne asimmetriche: il sì pesa, il no sta in tono minore. -->
    <div class="mt-14 grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
      <div data-reveal>
        <h3 class="font-display text-sm font-bold uppercase tracking-widest text-forest">{t.target.yesTitle}</h3>
        <ul class="mt-6 space-y-0">
          {t.target.yes.map((line) => (
            <li class="border-t border-line py-4 text-base leading-snug text-ink md:text-lg">{line}</li>
          ))}
        </ul>
      </div>

      <div data-reveal>
        <h3 class="font-display text-sm font-bold uppercase tracking-widest text-slate-soft">{t.target.noTitle}</h3>
        <ul class="mt-6 space-y-0">
          {t.target.no.map((line) => (
            <li class="border-t border-line py-4 text-sm text-slate">{line}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16" data-reveal>
      <h3 class="font-display text-sm font-bold uppercase tracking-widest text-slate">{t.target.areasLabel}</h3>
      <div class="mt-6 grid gap-8 sm:grid-cols-3">
        {t.target.areas.map((area, i) => (
          <div class="border-t-2 border-ink pt-4">
            <h4 class={`font-display text-xl font-bold ${AREA_ACCENT[i % 3]}`}>{area.name}</h4>
            <p class="mt-2 text-sm leading-relaxed text-slate">{area.verticals.join(' · ')}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <details class="disclosure">
        <summary class="text-ink">{t.target.detailsLabel}</summary>
        <div class="pb-2 pt-4">
          <h4 class="font-display text-sm font-bold uppercase tracking-widest text-slate">{t.target.criteriaTitle}</h4>
          <dl class="mt-4 grid gap-x-10 gap-y-5 sm:grid-cols-2">
            {t.target.criteria.map((c) => (
              <div>
                <dt class="text-sm font-semibold text-ink">{c.title}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-slate">{c.text}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-7 text-sm font-semibold text-ink">{t.target.emergingLabel}</p>
          <p class="mt-2 text-sm text-slate">{t.target.emerging.join(' · ')}</p>
        </div>
      </details>
    </div>
  </div>
</section>
