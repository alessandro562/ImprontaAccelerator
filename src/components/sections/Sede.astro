---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import DataTable from '../ui/DataTable.astro';
import Figure from '../ui/Figure.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { VENUE } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const address = `${VENUE.name}, ${VENUE.street}, ${VENUE.postalCode} ${VENUE.city}`;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---
<Section id="sede" background="paper-alt">
  <SectionHeader title={t.sede.title} />

  <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <p class="t-body max-w-2xl text-ink-muted">{t.sede.text}</p>
      <DataTable class="mt-8" headers={t.sede.factsHeaders} rows={t.sede.facts} />

      <div class="mt-8">
        <p class="t-label">{t.sede.addressLabel}</p>
        <address class="t-body mt-2 not-italic text-ink">{address}</address>
        <a href={mapUrl} target="_blank" rel="noopener" class="t-link t-small mt-2 inline-block">{t.sede.mapLabel}</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <Figure placeholder={t.sede.photoPlaceholder} ratio="4/3" />
    </div>
  </div>
</Section>
