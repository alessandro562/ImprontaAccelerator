---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * La foto della sede, se c'e'.
 *
 * Stesso meccanismo dei loghi dei promotori: `import.meta.glob` risolve a build
 * time, quindi basta lasciare il file in `src/assets/sede/`. Finche' manca
 * resta un segnaposto dichiarato, cosi' non si pubblica per sbaglio un vuoto.
 * Istruzioni in src/assets/sede/README.md.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/sede/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const foto = Object.values(files)[0]?.default;
---
<section class="sede" id="sede" aria-labelledby="sede-title">
  <div class="wrap sede__grid">
    <div class="sede__foto" data-in>
      {foto
        ? <img src={foto.src} alt={t.sede.label} width={foto.width} height={foto.height} />
        : <div class="sede__segnaposto" data-asset={t.sede.foto}><span>{t.sede.foto}</span></div>}
    </div>

    <div class="sede__testo">
      <span class="label" data-in>{t.sede.label}</span>
      <h2 class="display" id="sede-title" data-in="2">{t.sede.title}</h2>
      <p class="sede__lead" data-in="2">{t.sede.lead}</p>
      <dl class="sede__voci" data-in="3">
        {t.sede.voci.map((voce) => (
          <div>
            <dt>{voce.t}</dt>
            <dd>{voce.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
