---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

// Le tre fermate del gradiente ufficiale, una per effetto.
const ACCENT = ['#76B830', '#F9B233', '#D22F64'];
---
<section id="impatto" class="bg-ink-deep text-white">
  <div class="shell py-20 md:py-28">
    <p class="eyebrow eyebrow-dark" data-reveal>{t.change.eyebrow}</p>
    <h2 class="display-lg mt-5 max-w-[19ch]" data-reveal>{t.change.title}</h2>
    <p class="measure-wide mt-6 text-lg text-slate-soft md:text-xl" data-reveal>{t.change.lead}</p>

    <!-- Gli effetti prendono il trattamento tipografico grande: sono il messaggio. -->
    <ul class="mt-16 md:mt-20">
      {t.change.effects.map((effect, i) => (
        <li class="border-t border-white/12 py-9 md:py-11" data-reveal>
          <div class="grid gap-5 md:grid-cols-[1.25fr_1fr] md:items-start md:gap-14">
            <h3
              class="font-display text-[clamp(1.75rem,3.4vw,2.75rem)] font-extrabold leading-[1.08] tracking-tight"
              style={`color:${ACCENT[i]}`}
            >
              {effect.headline}
            </h3>
            <div>
              <p class="text-base leading-relaxed text-white md:text-lg">{effect.text}</p>
              <p class="mt-3 text-sm text-slate-soft">{effect.verticals.join(' · ')}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <!-- La misurazione: è ciò che distingue un acceleratore di impatto da uno generalista. -->
    <div class="mt-6 border-t border-white/12 pt-10 md:mt-10" data-reveal>
      <div class="grid gap-8 md:grid-cols-[1.25fr_1fr] md:gap-14">
        <div>
          <h3 class="font-display text-2xl font-extrabold tracking-tight text-white md:text-3xl">
            {t.change.measureTitle}
          </h3>
          <p class="measure-wide mt-4 text-base leading-relaxed text-slate-soft">{t.change.measureText}</p>
        </div>
        <div class="border-l-2 border-brand-pink pl-6">
          <p class="stat text-[clamp(2.25rem,4.6vw,3.5rem)] text-white">{t.change.measureStat.value}</p>
          <p class="mt-3 text-sm leading-snug text-slate-soft">{t.change.measureStat.label}</p>
        </div>
      </div>
    </div>

    <div class="mt-12" data-reveal>
      <details class="disclosure">
        <summary class="text-white/90 hover:text-white" style="border-color: rgb(255 255 255 / 0.12)">
          {t.change.detailsLabel}
        </summary>
        <div class="pb-2 pt-4">
          <p class="measure-wide text-sm leading-relaxed text-slate-soft">{t.change.detailsText}</p>
          <p class="mt-3 text-sm font-medium text-white">{t.change.emerging.join(' · ')}</p>
        </div>
      </details>
    </div>
  </div>
</section>
