---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="team" id="chi-siamo" aria-labelledby="team-title">
  <div class="wrap">
    <span class="label" id="team-title" data-in>{t.chiSiamo.label}</span>
    <ul class="orgs">
      {t.chiSiamo.orgs.map((org) => (
        <li class="org" data-in>
          <a class="org__name" href={org.url} target="_blank" rel="noopener">{org.name}</a>
          <span class="org__role">{org.role}</span>
        </li>
      ))}
    </ul>
    <div class="team__foot">
      {t.chiSiamo.notes.map((note, i) => (
        <div data-in={i === 0 ? true : '2'}><strong>{note.title}</strong>{note.text}</div>
      ))}
    </div>
  </div>
</section>
