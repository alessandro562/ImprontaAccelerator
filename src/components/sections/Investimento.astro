---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import DataTable from '../ui/DataTable.astro';
import Callout from '../ui/Callout.astro';
import Button from '../ui/Button.astro';
import { useTranslations } from '../../i18n';
import { localeUrl, type Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Section id="investimento">
  <SectionHeader title={t.investimento.title} lead={t.investimento.lead} />

  <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h3 class="t-h3 text-ink">{t.investimento.receiveTitle}</h3>
      <dl class="mt-5 border-t border-line">
        {t.investimento.receive.map((item) => (
          <div class="border-b border-line py-4">
            <dt class="t-body font-semibold text-ink">{item.title}</dt>
            <dd class="t-body mt-1 text-ink-muted">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <h3 class="t-h3 text-ink">{t.investimento.commitTitle}</h3>
      <dl class="mt-5 border-t border-line">
        {t.investimento.commit.map((item) => (
          <div class="border-b border-line py-4">
            <dt class="t-body font-semibold text-ink">{item.title}</dt>
            <dd class="t-body mt-1 text-ink-muted">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <Callout class="mt-12 max-w-3xl" title={t.investimento.calloutTitle}>
    {t.investimento.calloutText}
  </Callout>

  <div class="mt-16 max-w-3xl">
    <h3 class="t-h3 text-ink">{t.investimento.capitalTitle}</h3>
    <DataTable class="mt-5" headers={t.investimento.capitalHeaders} rows={t.investimento.capital} />
  </div>

  <div class="mt-10">
    <Button variant="secondary" href={localeUrl(locale, 'condizioni')}>{t.investimento.cta}</Button>
  </div>
</Section>
