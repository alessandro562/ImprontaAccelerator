---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="deal" class="bg-ink-deep text-white">
  <div class="shell py-20 md:py-28">
    <p class="eyebrow eyebrow-dark" data-reveal>{t.deal.eyebrow}</p>
    <h2 class="display-lg mt-5 max-w-[17ch]" data-reveal>{t.deal.title}</h2>
    <p class="measure-wide mt-6 text-lg text-slate-soft md:text-xl" data-reveal>{t.deal.lead}</p>

    <!-- Le cifre come oggetti grafici, non come etichette dentro una card. -->
    <dl class="mt-14 flex flex-wrap gap-x-16 gap-y-10 border-t border-white/10 pt-10 md:mt-20" data-reveal>
      {t.deal.figures.map((figure, i) => (
        <div>
          <dt class={`stat text-[clamp(2.5rem,6vw,4.5rem)] ${i === 0 ? 'text-gradient' : 'text-white'}`}>
            {figure.value}
          </dt>
          <dd class="mt-2 text-sm text-slate-soft">{figure.label}</dd>
        </div>
      ))}
    </dl>

    <ul class="mt-16 grid gap-10 md:grid-cols-3 md:gap-12">
      {t.deal.points.map((point, i) => (
        <li data-reveal>
          <span class="stat text-sm text-brand-pink">0{i + 1}</span>
          <h3 class="mt-3 font-display text-xl font-bold leading-snug text-white">{point.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-soft">{point.text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-14" data-reveal>
      <details class="disclosure">
        <summary class="text-white/90 hover:text-white" style="border-color: rgb(255 255 255 / 0.12)">
          {t.deal.detailsLabel}
        </summary>
        <div class="grid gap-7 pb-2 pt-4 sm:grid-cols-2">
          {t.deal.details.map((item) => (
            <div>
              <h4 class="text-sm font-semibold text-white">{item.h}</h4>
              <p class="mt-2 text-sm leading-relaxed text-slate-soft">{item.p}</p>
            </div>
          ))}
        </div>
      </details>
    </div>
  </div>
</section>
