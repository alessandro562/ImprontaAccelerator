---
import Cta from '../Cta.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="bg-cream">
  <div class="shell py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.5fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">{t.process.eyebrow}</p>
        <h2 class="mt-5 text-3xl leading-tight text-ink md:text-4xl">{t.process.title}</h2>
        <p class="mt-6 text-base leading-relaxed text-slate">{t.process.intro}</p>
        <Cta locale={locale} source="process" class="mt-8" />
      </div>

      <ol class="relative border-l border-line pl-8 md:pl-10">
        {t.process.steps.map((step, i) => (
          <li class="relative pb-9 last:pb-0">
            <span
              class="absolute -left-[2.3125rem] flex h-7 w-7 items-center justify-center rounded-full border border-line bg-white font-display text-xs font-bold text-ink md:-left-[2.8125rem]"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="text-lg leading-snug text-ink">{step.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <p class="mt-12 rounded-2xl border border-line bg-white p-6 text-sm leading-relaxed text-slate">
      {t.process.note}
    </p>
  </div>
</section>
