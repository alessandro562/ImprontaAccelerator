---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="border-t border-line bg-white">
  <div class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">{t.modules.eyebrow}</p>
      <h2 class="mt-5 text-3xl leading-tight text-ink md:text-4xl lg:text-5xl">{t.modules.title}</h2>
      <p class="mt-6 text-lg leading-relaxed text-slate">{t.modules.intro}</p>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
      {t.modules.items.map((mod, i) => (
        <li class="border-t-2 border-line pt-5">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg leading-snug text-ink">{mod.name}</h3>
            <span class="mt-1 shrink-0 font-display text-xs font-bold text-slate">
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-slate">{mod.text}</p>
          <p class="mt-4 text-xs font-medium text-brand-magenta">{t.modules.byLabel} {mod.by}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
