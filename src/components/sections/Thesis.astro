---
import Brandmark from '../Brandmark.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section id="programma" class="relative overflow-hidden bg-ink-deep text-white">
  <Brandmark
    uid="thesis"
    mono
    class="pointer-events-none absolute -left-32 bottom-0 h-[30rem] w-auto text-white/[0.04] md:-left-16 md:h-[38rem]"
  />

  <div class="shell relative py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow eyebrow-dark">{t.thesis.eyebrow}</p>
        <h2 class="mt-5 text-3xl leading-tight md:text-4xl lg:text-5xl">{t.thesis.title}</h2>
      </div>

      <div class="flex flex-col gap-5">
        {t.thesis.body.map((paragraph) => (
          <p class="text-base leading-relaxed text-slate-soft md:text-lg">{paragraph}</p>
        ))}
        <p class="mt-2 border-l-2 border-brand-magenta pl-5 font-display text-xl font-bold leading-snug text-white md:text-2xl">
          {t.thesis.manifesto}
        </p>
      </div>
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden rounded-2xl bg-white/10 md:mt-20 md:grid-cols-3">
      {t.thesis.pillars.map((pillar, i) => (
        <li class="bg-ink-deep p-7 md:p-8">
          <span class="font-display text-sm font-bold text-brand-pink">0{i + 1}</span>
          <h3 class="mt-3 text-lg text-white md:text-xl">{pillar.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-soft">{pillar.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
