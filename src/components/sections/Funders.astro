---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="border-y border-line bg-white">
  <div class="shell flex flex-col gap-8 py-9 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate">{t.funders.promotersLabel}</p>
      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {t.funders.promoters.map((name) => (
          <li class="font-display text-lg font-bold tracking-tight text-ink">{name}</li>
        ))}
      </ul>
    </div>

    <div class="max-w-xl lg:border-l lg:border-line lg:pl-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate">{t.funders.fundingLabel}</p>
      <p class="mt-2 text-sm leading-relaxed text-slate">{t.funders.funding}</p>
    </div>
  </div>
</section>
