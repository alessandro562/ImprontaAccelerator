---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="border-y border-line bg-bone">
  <div class="shell flex flex-col gap-5 py-7 lg:flex-row lg:items-baseline lg:justify-between lg:gap-10">
    <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate">{t.funders.promotersLabel}</p>
      <ul class="flex flex-wrap items-baseline gap-x-5">
        {t.funders.promoters.map((name) => (
          <li class="font-display text-lg font-bold tracking-tight text-ink">{name}</li>
        ))}
      </ul>
    </div>
    <p class="text-sm text-slate">
      <span class="font-semibold uppercase tracking-widest text-[0.7rem]">{t.funders.fundingLabel}</span>
      <span class="ml-2">{t.funders.funding}</span>
    </p>
  </div>
</section>
