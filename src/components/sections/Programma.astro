---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="numbers" id="programma" aria-labelledby="numbers-title">
  <div class="wrap">
    <div class="numbers__intro">
      <span class="label" data-in>{t.programma.label}</span>
      <p id="numbers-title" data-in="2">
        {t.programma.intro.before}<span class="it">{t.programma.intro.accent}</span>{t.programma.intro.after}
      </p>
    </div>
    <div class="numbers__grid">
      {t.programma.nums.map((num, i) => (
        <div class="num" data-in={i % 2 === 0 ? true : '2'}>
          <div class="num__v display">
            {num.prefix && <small>{num.prefix}</small>}{num.value}{num.accent && <span class="it">{num.accent}</span>}
          </div>
          <div class="num__l">{num.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
