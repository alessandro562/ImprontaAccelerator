---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="bg-ink-deep text-white">
  <div class="shell py-20 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow eyebrow-dark">{t.numbers.eyebrow}</p>
      <h2 class="mt-5 text-3xl leading-tight md:text-4xl lg:text-5xl">{t.numbers.title}</h2>
      <p class="mt-6 text-lg leading-relaxed text-slate-soft">{t.numbers.intro}</p>
    </div>

    <div class="mt-14 space-y-10">
      {t.numbers.groups.map((group) => (
        <div class="grid gap-6 border-t border-white/10 pt-8 lg:grid-cols-[1fr_2.2fr] lg:gap-12">
          <div>
            <h3 class="font-display text-xl font-bold text-white">{group.org}</h3>
            <p class="mt-1.5 text-sm text-slate-soft">{group.role}</p>
          </div>
          <dl class="grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
            {group.stats.map((stat) => (
              <div>
                <dt class="font-display text-2xl font-extrabold tracking-tight text-brand-amber md:text-3xl">{stat.value}</dt>
                <dd class="mt-2 text-sm leading-snug text-slate-soft">{stat.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
  </div>
</section>
