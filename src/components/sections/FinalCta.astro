---
import Cta from '../Cta.astro';
import Brandmark from '../Brandmark.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { CONTACT_EMAIL, formattedDeadline } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const deadline = formattedDeadline(locale);
---
<section class="relative overflow-hidden bg-ink-deep text-white">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-1"
    style="background-image: linear-gradient(90deg, #76B830, #F9B233, #E16251, #D22F64)"
    aria-hidden="true"
  >
  </div>
  <Brandmark
    uid="cta"
    class="pointer-events-none absolute -right-24 -top-28 h-[26rem] w-auto opacity-[0.14] md:right-0 md:h-[34rem]"
  />

  <div class="shell relative py-20 md:py-28">
    <h2 class="display-xl max-w-[14ch]" data-reveal>{t.finalCta.title}</h2>
    <p class="measure-wide mt-7 text-lg leading-relaxed text-slate-soft" data-reveal>{t.finalCta.text}</p>

    <div class="mt-10 flex flex-col items-start gap-5 sm:flex-row sm:items-center" data-reveal>
      <Cta locale={locale} source="final" variant="on-dark" class="text-base" />
      {deadline && (
        <p class="text-sm text-slate-soft">
          {t.finalCta.deadlinePrefix} <strong class="font-semibold text-white">{deadline}</strong>
        </p>
      )}
    </div>

    <p class="mt-8 text-sm text-slate-soft" data-reveal>
      {t.finalCta.contactPrefix}{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="font-medium text-white underline underline-offset-4">{CONTACT_EMAIL}</a>
    </p>
  </div>
</section>
