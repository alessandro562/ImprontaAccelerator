---
import Cta from '../Cta.astro';
import Brandmark from '../Brandmark.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { CONTACT_EMAIL, formattedDeadline } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const deadline = formattedDeadline(locale);
const subject = locale === 'it' ? 'Prossima coorte Impronta' : 'Next Impronta cohort';
---
<section class="relative overflow-hidden">
  <Brandmark
    uid="hero"
    class="pointer-events-none absolute -right-32 -top-24 h-[30rem] w-auto opacity-[0.07] sm:-right-20 md:-right-8 md:h-[42rem] md:opacity-[0.09]"
  />

  <div class="shell relative pb-16 pt-14 md:pb-24 md:pt-24">
    <!-- Quattro oggetti, non otto: titolo, una riga con il numero, azione, prova. -->
    <h1 data-reveal>
      <span class="block max-w-[26ch] font-display text-xl font-semibold leading-snug text-slate md:text-2xl lg:text-[1.75rem]">
        {t.hero.titleLead}
      </span>
      <span class="display-xl mt-4 block text-balance text-gradient">{t.hero.titleAccent}</span>
    </h1>

    <p class="measure-wide mt-8 text-lg leading-relaxed text-ink md:text-xl" data-reveal>
      {t.hero.sub}
    </p>

    <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center" data-reveal>
      <Cta locale={locale} source="hero" class="text-base" />
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`}
        class="text-sm font-medium text-slate underline decoration-line underline-offset-4 transition-colors hover:text-ink"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>

    {deadline && (
      <p class="mt-6 text-sm text-slate" data-reveal>
        {t.hero.deadlinePrefix} <strong class="font-semibold text-ink">{deadline}</strong>
      </p>
    )}
  </div>
</section>
