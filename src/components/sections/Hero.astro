---
import Cta from '../Cta.astro';
import Brandmark from '../Brandmark.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { CONTACT_EMAIL, formattedDeadline } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const deadline = formattedDeadline(locale);
const subject = locale === 'it' ? 'Prossima coorte Impronta' : 'Next Impronta cohort';
---
<section class="relative overflow-hidden">
  <Brandmark
    uid="hero"
    class="pointer-events-none absolute -right-36 -top-16 h-[26rem] w-auto opacity-[0.06] sm:-right-24 md:-right-10 md:h-[38rem] md:opacity-[0.08]"
  />

  <div class="shell relative pb-20 pt-16 md:pb-28 md:pt-28">
    <!-- La frase clou, sola. Il gradiente sta su una parola: e' l'accento, non lo sfondo. -->
    <h1 class="display-xl max-w-[14ch] text-balance text-ink" data-reveal>
      {t.hero.titleBefore}{' '}<span class="text-gradient-word">{t.hero.titleAccent}</span>{' '}{t.hero.titleAfter}
    </h1>

    <p class="measure-wide mt-8 text-lg leading-relaxed text-slate md:mt-10 md:text-xl" data-reveal>
      {t.hero.sub}
    </p>

    <div class="mt-10 flex flex-col items-start gap-4 sm:flex-row sm:items-center" data-reveal>
      <Cta locale={locale} source="hero" class="text-base" />
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`}
        class="text-sm font-medium text-slate underline decoration-line underline-offset-4 transition-colors hover:text-ink"
      >
        {t.hero.ctaSecondary}
      </a>
    </div>

    {deadline && (
      <p class="mt-6 text-sm text-slate" data-reveal>
        {t.hero.deadlinePrefix} <strong class="font-semibold text-ink">{deadline}</strong>
      </p>
    )}
  </div>
</section>
