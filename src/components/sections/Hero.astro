---
import Cta from '../Cta.astro';
import Button from '../ui/Button.astro';
import Figure from '../ui/Figure.astro';
import { useTranslations } from '../../i18n';
import { localeUrl, type Locale } from '../../i18n/utils';
import { formattedDeadline } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const deadline = formattedDeadline(locale);
const callStatus = deadline ? `${t.hero.callOpenPrefix} ${deadline}` : t.hero.callPending;
---
<section class="border-b border-line bg-paper pb-16 pt-14 md:pb-20 md:pt-20">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <p class="t-label text-forest">{callStatus}</p>

      <h1 class="t-h1 mt-5 text-balance">{t.hero.h1}</h1>

      <p class="t-lead mt-6 max-w-[62ch] text-ink-muted">{t.hero.lead}</p>

      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <Cta locale={locale} source="hero" label={t.hero.ctaPrimary} />
        <Button variant="link" href={localeUrl(locale, 'condizioni')}>{t.hero.ctaSecondary}</Button>
      </div>
    </div>

    <div class="lg:col-span-5">
      <Figure placeholder={t.hero.photoPlaceholder} ratio="4/3" />
    </div>
  </div>
</section>
