---
import Cta from '../Cta.astro';
import Pittogramma from '../Pittogramma.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';
import { hasApplicationForm } from '../../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

// Senza form di candidatura la call non è aperta: pallino grigio, non verde.
const live = hasApplicationForm;
const status = live ? t.hero.callOpen : t.hero.callPending;

// Le righe del titolo salgono in sequenza: il ritardo segue l'ordine.
const DELAYS = ['.15s', '.27s', '.39s'];
---
<section class="hero" id="top">
  <Pittogramma id="hg" animato class="hero__art" />

  <div class="wrap">
    <div class="hero__meta fade" style="animation-delay:.2s">
      <span class="label">{t.hero.place}</span>
      <span class:list={['label', live && 'label--live']}><span>{status}</span></span>
    </div>

    <h1 class="display">
      {t.hero.h1.map((line, i) => (
        <span class="line"><span class="rise" style={`animation-delay:${DELAYS[i] ?? '.39s'}`}>
          {line.text}{line.accent && <span class="it">{line.accent}</span>}
        </span></span>
      ))}
    </h1>

    <div class="hero__foot fade" style="animation-delay:.8s">
      <p class="hero__sub">{t.hero.sub.map((part) => (part.strong ? <strong>{part.text}</strong> : part.text))}</p>
      <div class="hero__cta">
        <Cta locale={locale} source="hero" label={t.hero.ctaPrimary} />
        <a class="link" href="#programma">{t.hero.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>
