---
import Section from '../ui/Section.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Steps from '../ui/Steps.astro';
import DataTable from '../ui/DataTable.astro';
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<Section id="calendario" background="paper-alt">
  <SectionHeader title={t.calendario.title} lead={t.calendario.lead} />

  <div class="mt-12">
    <h3 class="t-h3 text-ink">{t.calendario.selectionTitle}</h3>
    <Steps class="mt-6" steps={t.calendario.selection} />
  </div>

  <div class="mt-16">
    <h3 class="t-h3 text-ink">{t.calendario.programTitle}</h3>
    <DataTable class="mt-6" headers={t.calendario.moduleHeaders} rows={t.calendario.modules} />
  </div>

  <div class="mt-16 max-w-3xl">
    <h3 class="t-h3 text-ink">{t.calendario.afterTitle}</h3>
    <p class="t-body mt-4 text-ink-muted">{t.calendario.afterText}</p>
    <p class="t-body mt-4 text-ink-muted">{t.calendario.afterText2}</p>
  </div>
</Section>
