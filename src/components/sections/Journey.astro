---
import { useTranslations } from '../../i18n';
import type { Locale } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

// La larghezza di ogni fase è la sua durata reale. Il Demo Day diventa una
// scheggia: è vero, ed è un'informazione che nessun paragrafo darebbe.
const totalWeeks = t.journey.phases.reduce((sum, p) => sum + p.weeks, 0);
const pct = (weeks: number) => (weeks / totalWeeks) * 100;

// Le larghezze sono proporzionali, le colonne di testo sotto no: il colore è
// quello che lega ogni segmento alla sua descrizione. Sono le quattro fermate
// del gradiente ufficiale, nell'ordine.
const PHASE_COLOR = ['#76B830', '#F9B233', '#E16251', '#D22F64'];
---
<section id="percorso" class="bg-cream">
  <div class="shell py-20 md:py-28">
    <p class="eyebrow" data-reveal>{t.journey.eyebrow}</p>
    <h2 class="display-lg mt-5 max-w-[20ch] text-ink" data-reveal>{t.journey.title}</h2>
    <p class="measure-wide mt-6 text-lg text-slate" data-reveal>{t.journey.lead}</p>

    <div class="mt-14 md:mt-20" data-reveal>
      <!-- Il gradiente ufficiale, tagliato in proporzione alla durata -->
      <div
        class="flex h-3 w-full gap-1"
        role="img"
        aria-label={t.journey.phases.map((p) => `${p.name}: ${p.duration}`).join(' · ')}
      >
        {t.journey.phases.map((phase, i) => (
          <div
            class="rounded-full"
            style={`width:${pct(phase.weeks)}%; background-color:${PHASE_COLOR[i]}`}
          >
          </div>
        ))}
      </div>

      <ol class="mt-9 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {t.journey.phases.map((phase, i) => (
          <li class="border-t-[3px] pt-4" style={`border-color:${PHASE_COLOR[i]}`}>
            <p class="stat text-2xl text-ink md:text-[1.75rem]">{phase.duration}</p>
            <h3 class="mt-2 font-display text-base font-bold text-ink">{phase.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate">{phase.text}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-14" data-reveal>
      <details class="disclosure">
        <summary class="text-ink">{t.journey.detailsLabel}</summary>
        <div class="pb-2 pt-4">
          <h4 class="font-display text-sm font-bold uppercase tracking-widest text-slate">{t.journey.modulesTitle}</h4>
          <ul class="mt-4 grid gap-x-10 gap-y-4 sm:grid-cols-2">
            {t.journey.modules.map((mod) => (
              <li>
                <p class="text-sm font-semibold text-ink">
                  {mod.name} <span class="font-normal text-brand-magenta">· {mod.by}</span>
                </p>
                <p class="mt-1 text-sm leading-relaxed text-slate">{mod.text}</p>
              </li>
            ))}
          </ul>

          <h4 class="mt-9 font-display text-sm font-bold uppercase tracking-widest text-slate">{t.journey.processTitle}</h4>
          <ol class="mt-4 grid gap-x-10 gap-y-3 sm:grid-cols-2">
            {t.journey.steps.map((step, i) => (
              <li class="flex gap-3 text-sm">
                <span class="stat shrink-0 text-slate-soft">{i + 1}</span>
                <span><strong class="font-semibold text-ink">{step.name}</strong> — <span class="text-slate">{step.text}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </details>
    </div>
  </div>
</section>
