---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Sintesi from '../components/sections/Sintesi.astro';
import Programma from '../components/sections/Programma.astro';
import Requisiti from '../components/sections/Requisiti.astro';
import Investimento from '../components/sections/Investimento.astro';
import Calendario from '../components/sections/Calendario.astro';
import ChiSiamo from '../components/sections/ChiSiamo.astro';
import Sede from '../components/sections/Sede.astro';
import Faq from '../components/sections/Faq.astro';
import Chiusura from '../components/sections/Chiusura.astro';

import { useTranslations } from '../i18n';
import { currentLocale } from '../i18n/utils';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Le FAQ sono raggruppate per tema in pagina; i dati strutturati vogliono una
// lista piatta di domande.
const faqFlat = t.faq.groups.flatMap((group) => group.items);
---
<Base locale={locale} faq={faqFlat}>
  <Nav locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Sintesi locale={locale} />
    <Programma locale={locale} />
    <Requisiti locale={locale} />
    <Investimento locale={locale} />
    <Calendario locale={locale} />
    <ChiSiamo locale={locale} />
    <Sede locale={locale} />
    <Faq locale={locale} />
    <Chiusura locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
