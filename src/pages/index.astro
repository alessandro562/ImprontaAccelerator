---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Funders from '../components/sections/Funders.astro';
import Thesis from '../components/sections/Thesis.astro';
import Value from '../components/sections/Value.astro';
import Target from '../components/sections/Target.astro';
import Journey from '../components/sections/Journey.astro';
import Modules from '../components/sections/Modules.astro';
import Process from '../components/sections/Process.astro';
import Numbers from '../components/sections/Numbers.astro';
import Compare from '../components/sections/Compare.astro';
import Partners from '../components/sections/Partners.astro';
import Venue from '../components/sections/Venue.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';

import { useTranslations } from '../i18n';
import { currentLocale } from '../i18n/utils';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<Base locale={locale} faq={t.faq.items}>
  <Nav locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Funders locale={locale} />
    <Thesis locale={locale} />
    <Value locale={locale} />
    <Target locale={locale} />
    <Journey locale={locale} />
    <Modules locale={locale} />
    <Process locale={locale} />
    <Numbers locale={locale} />
    <Compare locale={locale} />
    <Partners locale={locale} />
    <Venue locale={locale} />
    <Faq locale={locale} />
    <FinalCta locale={locale} />
  </main>
  <Footer locale={locale} />
</Base>
