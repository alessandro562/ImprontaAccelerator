---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DataTable from '../components/ui/DataTable.astro';
import Button from '../components/ui/Button.astro';
import { useTranslations } from '../i18n';
import { currentLocale, localeUrl } from '../i18n/utils';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<Base
  locale={locale}
  pageKey="condizioni"
  title={`${t.condizioni.title} — Impronta Accelerator`}
  description={t.condizioni.lead}
>
  <Nav locale={locale} />

  <main id="main">
    <div class="border-b border-line bg-paper pb-12 pt-14 md:pb-16 md:pt-16">
      <div class="container-page max-w-3xl">
        <h1 class="t-h1">{t.condizioni.title}</h1>
        <p class="t-lead mt-5 text-ink-muted">{t.condizioni.lead}</p>
      </div>
    </div>

    <div class="container-page grid gap-12 py-14 md:py-20 lg:grid-cols-12 lg:gap-16">
      <nav class="lg:col-span-4 lg:sticky lg:top-28 lg:self-start" aria-label={t.condizioni.tocLabel}>
        <p class="t-label">{t.condizioni.tocLabel}</p>
        <ol class="mt-4 border-t border-line">
          {t.condizioni.sections.map((section) => (
            <li class="border-b border-line">
              <a href={`#${section.id}`} class="t-small block py-3 text-ink-muted transition-colors hover:text-ink">
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="lg:col-span-8">
        {t.condizioni.sections.map((section) => (
          <section id={section.id} class="mb-14 scroll-mt-28 last:mb-0">
            <h2 class="t-h2">{section.title}</h2>
            {section.text && <p class="t-body mt-4 text-ink-muted">{section.text}</p>}
            {section.rows.length > 0 && (
              <DataTable class="mt-6" headers={t.condizioni.clauseHeaders} rows={section.rows} />
            )}
          </section>
        ))}

        <div class="mt-14 border-t border-line pt-6">
          <p class="t-label">{t.condizioni.regulationLabel}</p>
          <p class="t-small mt-2 text-ink-muted">{t.condizioni.regulationNote}</p>
        </div>

        <div class="mt-10">
          <Button variant="secondary" href={localeUrl(locale)}>{t.condizioni.backHome}</Button>
        </div>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</Base>
