---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { useTranslations } from '../i18n';
import { currentLocale, localeUrl } from '../i18n/utils';
import '../styles/legal.css';

const locale = currentLocale(Astro.currentLocale);
const t = useTranslations(locale);
---
<Base locale={locale} title={`${t.notFound.title} — Impronta`} description={t.notFound.text}>
  <Nav locale={locale} solida />
  <main id="main" class="legal">
    <div class="wrap">
      <article class="legal__doc">
        <h1>{t.notFound.title}</h1>
        <p class="legal__intro">{t.notFound.text}</p>
        <div class="legal__back">
          <a class="btn btn--dark" href={localeUrl(locale)}>
            {t.notFound.back}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"/></svg>
          </a>
        </div>
      </article>
    </div>
  </main>
  <Footer locale={locale} />
</Base>
