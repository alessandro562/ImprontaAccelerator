---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localeUrl, type Locale } from '../i18n/utils';
import '../styles/legal.css';

interface Props {
  locale: Locale;
  pageKey: string;
  title: string;
  updated: string;
  updatedLabel: string;
  intro: string;
  sections: { h: string; p: string }[];
  back: string;
  placeholder: string;
  contact?: { prefix: string; email: string };
}

const { locale, pageKey, title, updated, updatedLabel, intro, sections, back, placeholder, contact } = Astro.props;
---
<Base locale={locale} pageKey={pageKey} title={`${title} — Impronta`} description={intro}>
  <Nav locale={locale} solida />
  <main id="main" class="legal">
    <div class="wrap">
      <article class="legal__doc">
        <h1>{title}</h1>
        <p class="legal__updated">{updatedLabel}: {updated}</p>
        <p class="legal__intro">{intro}</p>

        {sections.map((section) => (
          <section>
            <h2>{section.h}</h2>
            <p>{section.p}</p>
          </section>
        ))}

        {contact && (
          <p>
            {contact.prefix}{' '}
            <a href={`mailto:${contact.email}`}>{contact.email}</a>.
          </p>
        )}

        <p class="legal__note">{placeholder}</p>

        <div class="legal__back">
          <a class="btn btn--dark" href={localeUrl(locale)}>
            {back}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7"/></svg>
          </a>
        </div>
      </article>
    </div>
  </main>
  <Footer locale={locale} />
</Base>
