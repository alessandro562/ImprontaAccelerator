---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/ui/Button.astro';
import { localeUrl, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
  pageKey: string;
  title: string;
  updated: string;
  updatedLabel: string;
  intro: string;
  sections: { h: string; p: string }[];
  back: string;
  placeholder: string;
  contact?: { prefix: string; email: string };
}

const { locale, pageKey, title, updated, updatedLabel, intro, sections, back, placeholder, contact } = Astro.props;
---
<Base locale={locale} pageKey={pageKey} title={`${title} — Impronta Accelerator`} description={intro}>
  <Nav locale={locale} />
  <main id="main" class="container-page py-14 md:py-20">
    <article class="max-w-2xl">
      <h1 class="t-h1">{title}</h1>
      <p class="t-small mt-3 text-ink-muted">{updatedLabel}: {updated}</p>

      <p class="t-lead mt-8 text-ink-muted">{intro}</p>

      {sections.map((section) => (
        <section class="mt-10">
          <h2 class="t-h3 text-ink">{section.h}</h2>
          <p class="t-body mt-3 text-ink-muted">{section.p}</p>
        </section>
      ))}

      {contact && (
        <p class="t-body mt-10 text-ink-muted">
          {contact.prefix}{' '}
          <a href={`mailto:${contact.email}`} class="t-link">{contact.email}</a>.
        </p>
      )}

      <p class="t-small mt-12 border-l-[3px] border-line bg-paper-alt px-5 py-4 text-ink-muted">
        {placeholder}
      </p>

      <div class="mt-10">
        <Button variant="secondary" href={localeUrl(locale)}>{back}</Button>
      </div>
    </article>
  </main>
  <Footer locale={locale} />
</Base>
